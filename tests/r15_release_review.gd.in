extends SceneTree
## focused component challenges against an unchanged copied production probe.

class Hud:
	extends Control
	var identity: Label

class Probe:
	extends "res://probe.gd"
	var test_hud: Control
	func _ready() -> void:
		pass
	func _hud() -> Node:
		return test_hud

var results: Array = []

func observe(name: String, value: Variant) -> void:
	results.append({"name": name, "value": value})
	print("REVIEW ", name, ": ", value)

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	root.size = Vector2i(1280, 720)
	var probe := Probe.new()
	root.add_child(probe)
	var hud := Hud.new()
	probe.test_hud = hud
	root.add_child(hud)
	var label := Label.new()
	hud.identity = label
	hud.add_child(label)
	label.text = "BREAKWATER F2 CS:GO bhop server 128 Hz AA100"
	label.position = Vector2(30, 30)
	label.size = Vector2(650, 32)
	await process_frame
	observe("complete label admitted", probe._label_drawn("identity"))
	label.visible_characters = 1
	observe("one character label admitted", probe._label_drawn("identity"))
	observe("one character label actual limit", label.visible_characters)
	observe("label full text length", label.text.length())
	label.visible_characters = 0
	observe("zero character label admitted", probe._label_drawn("identity"))
	label.visible_characters = -1
	label.modulate.a = 0.0
	observe("transparent label admitted", probe._label_drawn("identity"))
	label.modulate.a = 1.0
	label.hide()
	observe("hidden label admitted", probe._label_drawn("identity"))
	label.show()
	hud.clip_contents = true
	hud.size = Vector2(10, 10)
	observe("clipped label admitted", probe._label_drawn("identity"))
	observe("clipping parent intersects label", hud.get_global_rect().intersects(label.get_global_rect()))
	hud.clip_contents = false
	var world := Node3D.new()
	root.add_child(world)
	var floor_mesh := MeshInstance3D.new()
	floor_mesh.name = "ReviewFloor"
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = PackedVector3Array([Vector3(-2, 0, -2), Vector3(-2, 0, 2), Vector3(2, 0, -2)])
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	floor_mesh.mesh = mesh
	var material := StandardMaterial3D.new()
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.albedo_color = Color(1, 1, 1, 1)
	floor_mesh.material_override = material
	world.add_child(floor_mesh)
	await process_frame
	var opaque := probe._drawn(world, true)
	observe("opaque floor scan", opaque)
	observe("opaque floor triangle", probe._triangle_at(world, Vector3(-0.5, 0, -0.5), opaque))
	material.albedo_color.a = 0.0
	var transparent := probe._drawn(world, true)
	observe("transparent material alpha", material.albedo_color.a)
	observe("transparent floor scan", transparent)
	observe("transparent floor triangle", probe._triangle_at(world, Vector3(-0.5, 0, -0.5), transparent))
	floor_mesh.hide()
	var hidden := probe._drawn(world, true)
	observe("hidden floor scan", hidden)
	observe("hidden floor triangle", probe._triangle_at(world, Vector3(-0.5, 0, -0.5), hidden))
	observe("integer tick array admitted", probe._same_ticks([1, 2, 3], [1, 2, 3]))
	observe("float tick array admitted", probe._same_ticks([1.0, 2.0, 3.0], [1, 2, 3]))
	observe("bool tick admitted", probe._same_ticks(true, 1))
	observe("truncated tick array admitted", probe._same_ticks([1, 2], [1, 2, 3]))
	observe("changed tick array admitted", probe._same_ticks([1, 2, 4], [1, 2, 3]))
	var output := ""
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--out="):
			output = arg.trim_prefix("--out=")
	var file := FileAccess.open(output, FileAccess.WRITE)
	file.store_string(JSON.stringify(results, "  ", false, true) + "\n")
	file.close()
	quit()
