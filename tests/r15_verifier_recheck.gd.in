extends SceneTree
## independent boundary fixtures; no game assets, export or drawing claim.

class Hud:
	extends Control
	var identity: Label

class Probe:
	extends "res://probe.gd"
	var test_hud: Control
	func _ready() -> void:
		pass
	func _hud() -> Node:
		return test_hud

var observations: Array = []

func record(name: String, actual: Variant, expected: Variant, detail: Variant = null) -> void:
	observations.append({"name": name, "actual": actual, "expected": expected, "ok": actual == expected, "detail": detail})

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	root.size = Vector2i(1280, 720)
	var probe := Probe.new()
	root.add_child(probe)
	var hud := Hud.new()
	hud.position = Vector2(10, 10)
	hud.size = Vector2(900, 400)
	root.add_child(hud)
	probe.test_hud = hud
	var outer := Control.new()
	outer.size = Vector2(800, 300)
	hud.add_child(outer)
	var inner := Control.new()
	inner.size = Vector2(700, 200)
	outer.add_child(inner)
	var label := Label.new()
	label.text = "BREAKWATER F2 CS:GO bhop server 128 Hz AA100"
	label.position = Vector2(20, 20)
	label.size = Vector2(650, 32)
	inner.add_child(label)
	hud.identity = label
	await process_frame
	outer.clip_contents = true
	inner.clip_contents = true
	record("two enclosing clipping ancestors admitted", probe._label_drawn("identity"), true)
	outer.size = Vector2(200, 150)
	record("outer ancestor clipping refused", probe._label_drawn("identity"), false)
	outer.size = Vector2(800, 300)
	inner.size = Vector2(150, 150)
	record("inner ancestor clipping refused", probe._label_drawn("identity"), false)
	inner.size = Vector2(700, 200)
	outer.modulate.a = 0.0
	record("ancestor alpha zero refused", probe._label_drawn("identity"), false)
	outer.modulate.a = 1.0
	label.self_modulate.a = 0.0
	record("self alpha zero refused", probe._label_drawn("identity"), false)
	label.self_modulate.a = 1.0
	label.visible_ratio = 0.5
	record("partial visible ratio refused", probe._label_drawn("identity"), false, label.visible_characters)
	label.visible_ratio = 1.0
	label.clip_text = true
	label.size.x = 1.0
	await process_frame
	var text_width := label.get_theme_font("font").get_string_size(label.text, HORIZONTAL_ALIGNMENT_LEFT, -1, label.get_theme_font_size("font_size")).x
	record("horizontally clipped essential text refused", probe._label_drawn("identity"), false,
		{"clip_text": label.clip_text, "label_width": label.size.x, "font_text_width": text_width, "visible_characters": label.visible_characters})
	label.clip_text = false
	label.size = Vector2(650, 32)
	label.text = "BREAKWATER\nF2 CS:GO bhop server 128 Hz AA100"
	label.max_lines_visible = 1
	await process_frame
	record("line-limited essential text refused", probe._label_drawn("identity"), false,
		{"line_count": label.get_line_count(), "visible_line_count": label.get_visible_line_count(), "max_lines_visible": label.max_lines_visible})
	label.max_lines_visible = -1
	label.text = "BREAKWATER F2 CS:GO bhop server 128 Hz AA100"
	await process_frame
	record("restored full label admitted", probe._label_drawn("identity"), true)

	var world := Node3D.new()
	root.add_child(world)
	var floor_mesh := MeshInstance3D.new()
	floor_mesh.name = "Floor"
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = PackedVector3Array([Vector3(-2, 0, -2), Vector3(-2, 0, 2), Vector3(2, 0, -2)])
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	floor_mesh.mesh = mesh
	var material := StandardMaterial3D.new()
	floor_mesh.material_override = material
	world.add_child(floor_mesh)
	var point := Vector3(-0.5, 0, -0.5)
	material.albedo_color.a = 0.0
	record("alpha ignored by opaque mode stays drawable", probe._triangle_at(world, point, probe._drawn(world, true)), "Floor")
	for mode: int in [BaseMaterial3D.TRANSPARENCY_ALPHA, BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR, BaseMaterial3D.TRANSPARENCY_ALPHA_HASH, BaseMaterial3D.TRANSPARENCY_ALPHA_DEPTH_PRE_PASS]:
		material.transparency = mode
		record("zero alpha mode %d refused" % mode, probe._triangle_at(world, point, probe._drawn(world, true)), "")
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	material.alpha_scissor_threshold = 0.5
	material.albedo_color.a = 0.25
	record("scissor-discarded floor refused", probe._triangle_at(world, point, probe._drawn(world, true)), "",
		{"alpha": material.albedo_color.a, "scissor_threshold": material.alpha_scissor_threshold})
	material.albedo_color.a = 0.75
	record("above scissor threshold admitted", probe._triangle_at(world, point, probe._drawn(world, true)), "Floor")
	material.albedo_color.a = 0.01
	material.alpha_scissor_threshold = 0.001
	record("low-alpha opaque scissor floor admitted", probe._triangle_at(world, point, probe._drawn(world, true)), "Floor",
		{"alpha": material.albedo_color.a, "scissor_threshold": material.alpha_scissor_threshold})
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.albedo_color.a = 0.0
	var invisible := StandardMaterial3D.new()
	invisible.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	invisible.albedo_color.a = 0.0
	material.next_pass = invisible
	record("two invisible passes refused", probe._triangle_at(world, point, probe._drawn(world, true)), "")
	invisible.next_pass = StandardMaterial3D.new()
	record("third opaque pass admitted", probe._triangle_at(world, point, probe._drawn(world, true)), "Floor")
	material.next_pass = null
	floor_mesh.transparency = 1.0
	record("geometry transparency refused", probe._triangle_at(world, point, probe._drawn(world, true)), "")
	floor_mesh.transparency = 0.0
	floor_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY
	record("shadow-only floor refused", probe._triangle_at(world, point, probe._drawn(world, true)), "")
	floor_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	var branch := Node3D.new()
	world.add_child(branch)
	var other := MeshInstance3D.new()
	other.name = "Floor"
	other.mesh = mesh
	other.material_override = StandardMaterial3D.new()
	other.position.x = 20.0
	branch.add_child(other)
	var duplicate := probe._drawn(world, true)
	record("same-name opaque sibling cannot validate invisible floor", probe._triangle_at(world, point, duplicate), "",
		{"invisible_path": str(floor_mesh.get_path()), "opaque_path": str(other.get_path()), "drawn": duplicate})
	record("same-name opaque sibling still admitted at its own location", probe._triangle_at(world, point + Vector3(20, 0, 0), duplicate), "Floor")
	other.name = "DistinctFloor"
	record("distinct-name opaque sibling cannot validate invisible floor", probe._triangle_at(world, point, probe._drawn(world, true)), "")
	var output := ""
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--out="):
			output = arg.trim_prefix("--out=")
	var file := FileAccess.open(output, FileAccess.WRITE)
	file.store_string(JSON.stringify(observations, "  ", false, true) + "\n")
	file.close()
	quit()
